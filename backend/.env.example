NODE_ENV=development
PORT=3001
HOST=0.0.0.0
# Copy your Neon pooled connection string. Keep credentials on the server only.
DATABASE_URL=postgresql://USER:PASSWORD@ep-YOUR-PROJECT-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
# Neon direct (non-pooler) URL for migrations.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-YOUR-PROJECT.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
FRONTEND_URL=http://localhost:5173/
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Register this exact callback URL in your Google OAuth web application.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SAME_SITE=lax
SESSION_DAYS=30
# Set to the exact number of trusted reverse proxies in your host topology.
TRUST_PROXY_HOPS=0
